<?xml version="1.0" encoding="utf-8" ?>
<!-- A "Who's watching?" tile: the profile's photo, or its initial on its avatar color, and its name. -->
<component name="ProfileItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/items/ProfileItem.brs" />
    <children>
        <Rectangle id="frame" width="230" height="230" translation="[-5, -5]" color="0xFFFFFFFF" opacity="0" />
        <Rectangle id="avatar" width="220" height="220" color="0xE50914FF" />
        <Label id="initial" width="220" height="220" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="110" />
        </Label>
        <Poster id="photo" width="220" height="220" loadWidth="220" loadHeight="220" loadDisplayMode="scaleToZoom" />
        <Label id="name" width="220" translation="[0, 236]" horizAlign="center" color="0xB3B3B3FF">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <Label id="badge" width="220" translation="[0, 274]" horizAlign="center" color="0x808080FF">
            <Font role="font" uri="font:SystemFontFile" size="20" />
        </Label>
    </children>
</component>
