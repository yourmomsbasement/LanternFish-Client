<?xml version="1.0" encoding="utf-8" ?>
<!-- Plays a movie or episode (a show starts at its next episode), reports progress to Jellyfin and plays on to the next episode. -->
<component name="PlayerScreen" extends="JFScreen">
    <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/DeviceProfile.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="true" />
        <BusySpinner id="spinner" translation="[928, 508]" visible="false" />
        <Timer id="progress" duration="10" repeat="true" />
    </children>
</component>
