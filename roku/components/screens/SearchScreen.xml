<?xml version="1.0" encoding="utf-8" ?>
<!-- Search by title, plus the JellyFlix plugin's "Matches your description" (plot, genres, cast, and meaning). -->
<component name="SearchScreen" extends="JFScreen">
    <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/components/common/Themes.brs" />
    <children>
        <Label text="Search" translation="[120, 70]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="52" />
        </Label>
        <MiniKeyboard id="keyboard" translation="[100, 170]" />
        <Label id="hint" translation="[720, 190]" width="1080" wrap="true" color="0xB3B3B3FF"
               text="Search for a title, or describe it: &quot;space movie with a stranded astronaut&quot;.">
            <Font role="font" uri="font:SystemFontFile" size="28" />
        </Label>
        <RowList id="results" translation="[720, 170]" itemComponentName="PosterItem"
                 itemSize="[1120, 360]" itemSpacing="[0, 30]" numRows="3"
                 rowItemSize="[[160, 240]]" rowItemSpacing="[[20, 0]]"
                 showRowLabel="[true]" rowLabelOffset="[[0, 12]]" rowLabelColor="0xE5E5E5FF"
                 drawFocusFeedback="false" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus">
            <Font role="rowLabelFont" uri="font:BoldSystemFontFile" size="28" />
        </RowList>
        <Timer id="debounce" duration="0.6" />
    </children>
</component>
